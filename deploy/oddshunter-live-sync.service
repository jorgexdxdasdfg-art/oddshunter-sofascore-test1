[Unit]
Description=OddsHunter live and recent result synchronizer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=oddshunter
Group=oddshunter
WorkingDirectory=/opt/oddshunter/current
EnvironmentFile=/etc/oddshunter/oddshunter.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
Environment=ODDSHUNTER_RUNTIME_MODE=cloud
Environment=ODDSHUNTER_WORK_DB=/var/lib/oddshunter/data/oddshunter.db
Environment=ODDSHUNTER_ALLOW_WORK_DB_WRITE=1
Environment=ODDSHUNTER_STAGE6_ALLOW_TURSO_WRITE=1
Environment=ODDSHUNTER_DISABLE_TRAINING=1
Environment=ODDSHUNTER_BROWSER_HEADLESS=1
Environment=ODDSHUNTER_CHROMIUM_SANDBOX=0
Environment=ODDSHUNTER_LIVE_NEAR_LIMIT=12
Environment=ODDSHUNTER_LIVE_OVERDUE_LIMIT=6
ExecStart=/opt/oddshunter/current/.venv-cloud/bin/python -u /opt/oddshunter/current/cloud_live_status_sync.py
TimeoutStartSec=600
Nice=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
