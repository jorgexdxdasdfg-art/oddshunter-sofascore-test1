[Unit]
Description=OddsHunter complete active-league schedule refresh
After=network-online.target oddshunter.service
Wants=network-online.target

[Service]
Type=oneshot
User=oddshunter
Group=oddshunter
WorkingDirectory=/opt/oddshunter/current
EnvironmentFile=/etc/oddshunter/oddshunter.env
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
Environment=ODDSHUNTER_RUNTIME_MODE=cloud
Environment=ODDSHUNTER_ALLOW_WORK_DB_WRITE=1
Environment=ODDSHUNTER_BROWSER_HEADLESS=1
Environment=ODDSHUNTER_CHROMIUM_SANDBOX=0
ExecStart=/opt/oddshunter/current/.venv-cloud/bin/python -u /opt/oddshunter/current/cloud_schedule_refresh.py
TimeoutStartSec=45min

[Install]
WantedBy=multi-user.target
